# AI Payment Recovery Agent Environment Configuration
# Duplicate this file as .env and populate your GROQ_API_KEY if testing live LLM mode.

# Set to "true" for zero-setup demo mode (serves from pre-computed cache, no API key required)
# Set to "false" to enable live Groq LLM API calls on new inputs
DEMO_MODE=true

# Optional: Groq API Key (Obtain free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
