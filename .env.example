# RecoverAI — Environment Configuration
# Copy this file to .env and populate with your credentials.
# The app works FULLY OFFLINE with DEMO_MODE=true (no keys needed).

# --- DEMO MODE (default: true) ---
# Set to "true" for zero-setup demo mode: serves from pre-computed cache, no API keys required.
# Set to "false" to enable live Groq LLM API calls on new inputs.
DEMO_MODE=true

# --- GROQ LLM API (optional, for live mode) ---
# Obtain a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- RAZORPAY TEST-MODE INTEGRATION (optional) ---
# Set RAZORPAY_LIVE_INTEGRATION=true AND provide your test-mode keys to enable
# real Razorpay API calls (create payment links, orders, customer objects).
# Test-mode keys start with rzp_test_... (no real money involved).
# Obtain from: Razorpay Dashboard → Settings → API Keys → Test Mode
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_LIVE_INTEGRATION=false
